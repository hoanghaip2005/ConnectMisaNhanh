# Server Configuration
PORT=3000
NODE_ENV=development
SERVER_URL=https://api.activ.vn

# Nhanh.vn API Configuration
NHANH_APP_ID=your_app_id_here
NHANH_SECRET_KEY=your_secret_key_here
NHANH_API_VERSION=3.0
NHANH_BASE_URL=https://pos.open.nhanh.vn
NHANH_OAUTH_URL=https://nhanh.vn/oauth

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://activ.ngrok.dev,https://yourdomain.com

# Operations Dashboard
OPS_DASHBOARD_ENABLED=false
OPS_DASHBOARD_USERNAME=opsadmin
OPS_DASHBOARD_PASSWORD=change_this_password
PM2_OUT_LOG_PATH=/home/ubuntu/.pm2/logs/middleware-integration-out.log
PM2_ERROR_LOG_PATH=/home/ubuntu/.pm2/logs/middleware-integration-error.log

# MySQL Configuration for Webhook Queue
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=middleware_integration
